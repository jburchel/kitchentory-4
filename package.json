{
  "name": "kitchentory",
  "version": "1.0.0",
  "description": "Mobile-first kitchen inventory management system",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run --workspace=@kitchentory/api dev & npm run --workspace=@kitchentory/mobile start",
    "api:dev": "npm run --workspace=@kitchentory/api dev",
    "mobile:start": "npm run --workspace=@kitchentory/mobile start",
    "ios": "npm run --workspace=@kitchentory/mobile ios",
    "android": "npm run --workspace=@kitchentory/mobile android",
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "test:integration": "npm run test:integration --workspaces",
    "test:e2e": "npm run test:e2e --workspaces",
    "lint": "npm run --workspace=@kitchentory/api lint && npm run --workspace=@kitchentory/mobile lint",
    "format": "prettier --write .",
    "db:migrate": "npm run --workspace=@kitchentory/api db:migrate",
    "db:seed": "npm run --workspace=@kitchentory/api db:seed"
  },
